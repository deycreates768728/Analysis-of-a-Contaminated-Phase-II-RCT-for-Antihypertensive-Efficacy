  upper_bound <- q3 + (1.5 * iqr)
\end_layout

\begin_layout Plain Layout

  
\end_layout

\begin_layout Plain Layout

  outliers <- values[values < lower_bound | values > upper_bound]
\end_layout

\begin_layout Plain Layout

  
\end_layout

\begin_layout Plain Layout

  return(outliers)
\end_layout

\begin_layout Plain Layout

}
