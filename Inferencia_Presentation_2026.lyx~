\begin_layout Plain Layout

impute=function(x){
\end_layout

\begin_layout Plain Layout

  mu=mean(x,na.rm=TRUE)
\end_layout

\begin_layout Plain Layout

  std=sd(x,na.rm=TRUE)
\end_layout

\begin_layout Plain Layout

  low=min(x,na.rm=TRUE)
\end_layout

\begin_layout Plain Layout

  up=max(x,na.rm=TRUE)
\end_layout

\begin_layout Plain Layout

  #identify NA indices
\end_layout

\begin_layout Plain Layout

  na_id=is.na(x)
\end_layout

\begin_layout Plain Layout

  #Generate values from Truncated Normal Distribution
\end_layout

\begin_layout Plain Layout

  x[na_id]=rtruncnorm(sum(na_id),a=low,b=up,mean=mu,sd=std)
\end_layout

\begin_layout Plain Layout

  return(x)
\end_layout

\begin_layout Plain Layout

}
